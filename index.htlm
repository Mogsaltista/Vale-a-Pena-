<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0b1120">
  <title>Vale a Pena? | Compare antes de comprar</title>

  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --bg: #0b1120;
      --card: #141d2e;
      --field: #0d1626;
      --border: #293750;
      --text: #f5f7fb;
      --muted: #9eabc0;
      --green: #50dfa0;
      --green-dark: #102e26;
      --blue: #78a5ff;
      --red: #ff8585;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.5;
    }

    .container {
      width: calc(100% - 30px);
      max-width: 760px;
      margin: 0 auto;
    }

    header {
      border-bottom: 1px solid var(--border);
      padding: 22px 0;
    }

    .brand {
      font-size: 23px;
      font-weight: 900;
      letter-spacing: -0.8px;
    }

    .brand span {
      color: var(--green);
    }

    .tagline {
      margin-top: 3px;
      color: var(--muted);
      font-size: 13px;
    }

    .hero {
      padding: 38px 0 22px;
    }

    .eyebrow {
      color: var(--green);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1.5px;
    }

    h1 {
      margin: 9px 0;
      font-size: clamp(34px, 9vw, 48px);
      line-height: 1.05;
      letter-spacing: -1.8px;
    }

    .hero p {
      color: var(--muted);
      font-size: 15px;
      max-width: 650px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 21px;
      margin: 18px 0;
    }

    h2 {
      margin: 0 0 4px;
      font-size: 21px;
    }

    .subtitle {
      margin: 0 0 20px;
      color: var(--muted);
      font-size: 13px;
    }

    .section-title {
      margin: 25px 0 12px;
      font-size: 15px;
      font-weight: 800;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .field {
      margin-bottom: 14px;
    }

    label {
      display: block;
      margin-bottom: 7px;
      font-size: 13px;
      font-weight: 700;
    }

    input,
    select {
      width: 100%;
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--field);
      color: var(--text);
      font: inherit;
      font-size: 15px;
    }

    input:focus,
    select:focus {
      outline: 2px solid var(--green);
      outline-offset: 1px;
    }

    .hint {
      margin: -5px 0 0;
      color: var(--muted);
      font-size: 12px;
    }

    button {
      width: 100%;
      border: 0;
      border-radius: 11px;
      padding: 15px;
      margin-top: 8px;
      background: var(--green);
      color: #082016;
      font: inherit;
      font-weight: 900;
      cursor: pointer;
    }

    button:active {
      transform: scale(0.99);
    }

    .error {
      min-height: 18px;
      margin-top: 10px;
      color: var(--red);
      font-size: 13px;
    }

    .hidden {
      display: none;
    }

    .winner {
      margin: 18px 0;
      padding: 23px 15px;
      text-align: center;
      background: var(--green-dark);
      border: 1px solid #337d60;
      border-radius: 15px;
    }

    .trophy {
      font-size: 34px;
    }

    .winner h2 {
      margin: 7px 0 3px;
      color: var(--green);
      font-size: 25px;
    }

    .winner p {
      margin: 0;
      color: #c6e8dc;
      font-size: 14px;
    }

    .score-box {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin: 15px 0;
    }

    .score {
      padding: 14px;
      background: var(--field);
      border: 1px solid var(--border);
      border-radius: 12px;
      text-align: center;
    }

    .score small {
      display: block;
      color: var(--muted);
      font-size: 12px;
    }

    .score strong {
      display: block;
      margin-top: 5px;
      font-size: 25px;
    }

    .stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin: 15px 0;
    }

    .stat {
      padding: 13px;
      background: var(--field);
      border: 1px solid var(--border);
      border-radius: 11px;
    }

    .stat small {
      display: block;
      color: var(--muted);
      font-size: 12px;
    }

    .stat strong {
      display: block;
      margin-top: 4px;
      font-size: 18px;
    }

    .comparison {
      margin-top: 12px;
    }

    .comparison-row {
      padding: 15px 0;
      border-bottom: 1px solid var(--border);
    }

    .comparison-row:last-child {
      border-bottom: 0;
    }

    .metric {
      margin-bottom: 9px;
      font-size: 14px;
      font-weight: 800;
    }

    .values {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .value {
      color: var(--muted);
      font-size: 13px;
    }

    .value strong {
      display: block;
      color: var(--text);
      font-size: 16px;
      overflow-wrap: anywhere;
    }

    .value.best strong {
      color: var(--green);
    }

    .badge {
      display: inline-block;
      margin-top: 5px;
      padding: 3px 7px;
      border-radius: 20px;
      background: #173b30;
      color: var(--green);
      font-size: 10px;
      font-weight: 900;
    }

    .verdict {
      color: #d4dced;
      font-size: 14px;
    }

    .info {
      color: var(--muted);
      font-size: 13px;
    }

    footer {
      padding: 25px 0 35px;
      text-align: center;
      color: var(--muted);
      font-size: 12px;
    }

    @media (max-width: 480px) {
      .card {
        padding: 16px;
      }

      .grid {
        gap: 9px;
      }

      input,
      select {
        padding: 11px 9px;
        font-size: 14px;
      }

      .stat strong {
        font-size: 16px;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="container">
      <div class="brand">VALE <span>A PENA?</span></div>
      <div class="tagline">Decisões melhores. Dinheiro mais bem gasto.</div>
    </div>
  </header>

  <main class="container">

    <section class="hero">
      <div class="eyebrow">COMPRE COM INTELIGÊNCIA</div>

      <h1>
        Antes de comprar,<br>
        compare.
      </h1>

      <p>
        Compare duas opções considerando preço, durabilidade,
        frequência de uso e custo-benefício.
      </p>
    </section>

    <form id="comparisonForm">

      <section class="card">

        <h2>01. Suas opções</h2>

        <p class="subtitle">
          Digite os dois produtos que você está pensando em comprar.
        </p>

        <div class="grid">

          <div class="field">
            <label for="productA">Produto A</label>
            <input
              id="productA"
              type="text"
              placeholder="Ex.: iPhone 15"
              required
            >
          </div>

          <div class="field">
            <label for="productB">Produto B</label>
            <input
              id="productB"
              type="text"
              placeholder="Ex.: Galaxy S24"
              required
            >
          </div>

          <div class="field">
            <label for="priceA">Preço do A (R$)</label>
            <input
              id="priceA"
              type="number"
              min="0.01"
              step="0.01"
              placeholder="3500"
              required
            >
          </div>

          <div class="field">
            <label for="priceB">Preço do B (R$)</label>
            <input
              id="priceB"
              type="number"
              min="0.01"
              step="0.01"
              placeholder="3000"
              required
            >
          </div>

        </div>

        <div class="section-title">
          02. Durabilidade estimada
        </div>

        <div class="grid">

          <div class="field">
            <label for="yearsA">Duração do A (anos)</label>
            <input
              id="yearsA"
              type="number"
              min="0.1"
              step="0.1"
              placeholder="5"
              required
            >
          </div>

          <div class="field">
            <label for="yearsB">Duração do B (anos)</label>
            <input
              id="yearsB"
              type="number"
              min="0.1"
              step="0.1"
              placeholder="4"
              required
            >
          </div>

        </div>

        <p class="hint">
          Quanto tempo você acredita que cada produto vai durar?
        </p>

        <div class="section-title">
          03. Frequência de uso
        </div>

        <div class="grid">

          <div class="field">
            <label for="usesA">Usos por semana — A</label>
            <input
              id="usesA"
              type="number"
              min="0"
              step="1"
              placeholder="35"
              required
            >
          </div>

          <div class="field">
            <label for="usesB">Usos por semana — B</label>
            <input
              id="usesB"
              type="number"
              min="0"
              step="1"
              placeholder="35"
              required
            >
          </div>

        </div>

        <p class="hint">
          Use o mesmo critério para os dois produtos.
        </p>

        <div class="section-title">
          04. Sua prioridade
        </div>

        <div class="field">

          <label for="priority">
            O que mais importa para você?
          </label>

          <select id="priority">
            <option value="balance">
              Equilíbrio geral
            </option>

            <option value="price">
              Gastar menos agora
            </option>

            <option value="durability">
              Durar mais tempo
            </option>

            <option value="use">
              Menor custo por utilização
            </option>
          </select>

        </div>

        <button type="submit">
          Comparar produtos →
        </button>

        <div id="error" class="error"></div>

      </section>

    </form>


    <section id="result" class="card hidden">

      <div class="eyebrow">
        SUA ANÁLISE
      </div>

      <h2>
        Resultado da comparação
      </h2>

      <p class="subtitle">
        Veja qual opção apresenta o melhor resultado nos critérios escolhidos.
      </p>


      <div class="winner">

        <div class="trophy">🏆</div>

        <h2 id="winnerName">
          -
        </h2>

        <p id="winnerReason">
          -
        </p>

      </div>


      <div class="score-box">

        <div class="score">
          <small id="scoreLabelA">
            Produto A
          </small>

          <strong id="scoreA">
            0
          </strong>
        </div>

        <div class="score">
          <small id="scoreLabelB">
            Produto B
          </small>

          <strong id="scoreB">
            0
          </strong>
        </div>

      </div>


      <div class="stats">

        <div class="stat">
          <small>Menor preço inicial</small>
          <strong id="lowestPrice">-</strong>
        </div>

        <div class="stat">
          <small>Menor custo anual</small>
          <strong id="lowestAnnual">-</strong>
        </div>

      </div>


      <div class="section-title">
        Comparação detalhada
      </div>

      <div id="details" class="comparison"></div>


      <div class="section-title">
        Veredito final
      </div>

      <p id="verdict" class="verdict">
        -
      </p>


      <p class="info">
        Os resultados são estimativas baseadas nos dados que você informou.
        O site não considera manutenção, reparos, inflação, revenda ou diferenças
        de qualidade.
      </p>


      <button id="newComparison" type="button">
        Fazer nova comparação
      </button>

    </section>


    <section class="card">

      <h2>
        Como funciona?
      </h2>

      <p class="info">
        O Vale a Pena? compara o preço, a duração estimada e a frequência
        de utilização de duas opções. A partir desses dados, calcula o
        custo anual e o custo estimado por utilização.
      </p>

      <p class="info">
        A recomendação é uma ferramenta de apoio à decisão. Você continua
        sendo quem decide o que realmente vale a pena para você.
      </p>

    </section>

  </main>


  <footer>
    VALE A PENA? · Pense antes de gastar.
  </footer>


  <script>

    (function () {

      "use strict";


      const form = document.getElementById("comparisonForm");
      const result = document.getElementById("result");
      const error = document.getElementById("error");


      function getNumber(id) {
        return Number(document.getElementById(id).value);
      }


      function money(value) {
        return value.toLocaleString("pt-BR", {
          style: "currency",
          currency: "BRL"
        });
      }


      function number(value) {
        return value.toLocaleString("pt-BR", {
          minimumFractionDigits: 1,
          maximumFractionDigits: 2
        });
      }


      function escapeHTML(value) {
        return String(value).replace(/[&<>"']/g, function (character) {

          const characters = {
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#039;"
          };

          return characters[character];

        });
      }


      function createRow(title, a, b, formatter, better) {

        let aBetter = false;
        let bBetter = false;

        if (better === "lower") {

          aBetter = a < b;
          bBetter = b < a;

        } else {

          aBetter = a > b;
          bBetter = b > a;

        }


        return `
          <div class="comparison-row">

            <div class="metric">
              ${title}
            </div>

            <div class="values">

              <div class="value ${aBetter ? "best" : ""}">
                <strong>${formatter(a)}</strong>

                ${
                  aBetter
                    ? '<span class="badge">MELHOR</span>'
                    : ""
                }
              </div>


              <div class="value ${bBetter ? "best" : ""}">
                <strong>${formatter(b)}</strong>

                ${
                  bBetter
                    ? '<span class="badge">MELHOR</span>'
                    : ""
                }
              </div>

            </div>

          </div>
        `;
      }


      form.addEventListener("submit", function (event) {

        event.preventDefault();

        error.textContent = "";


        const a = {

          name: document.getElementById("productA").value.trim(),

          price: getNumber("priceA"),

          years: getNumber("yearsA"),

          uses: getNumber("usesA")

        };


        const b = {

          name: document.getElementById("productB").value.trim(),

          price: getNumber("priceB"),

          years: getNumber("yearsB"),

          uses: getNumber("usesB")

        };


        if (!a.name || !b.name) {

          error.textContent =
            "Digite o nome dos dois produtos.";

          return;
        }


        const validNumbers =
          Number.isFinite(a.price) &&
          Number.isFinite(b.price) &&
          Number.isFinite(a.years) &&
          Number.isFinite(b.years) &&
          Number.isFinite(a.uses) &&
          Number.isFinite(b.uses);


        if (!validNumbers) {

          error.textContent =
            "Confira os números informados.";

          return;
        }


        if (
          a.price <= 0 ||
          b.price <= 0 ||
          a.years <= 0 ||
          b.years <= 0 ||
          a.uses < 0 ||
          b.uses < 0
        ) {

          error.textContent =
            "Preço e duração devem ser maiores que zero.";

          return;
        }


        a.annualCost = a.price / a.years;
        b.annualCost = b.price / b.years;


        a.totalUses = a.uses * 52 * a.years;
        b.totalUses = b.uses * 52 * b.years;


        a.costPerUse =
          a.totalUses > 0
            ? a.price / a.totalUses
            : null;


        b.costPerUse =
          b.totalUses > 0
            ? b.price / b.totalUses
            : null;


        let scoreA = 0;
        let scoreB = 0;


        if (a.price < b.price) {
          scoreA++;
        } else if (b.price < a.price) {
          scoreB++;
        }


        if (a.years > b.years) {
          scoreA++;
        } else if (b.years > a.years) {
          scoreB++;
        }


        if (
          a.costPerUse !== null &&
          b.costPerUse !== null
        ) {

          if (a.costPerUse < b.costPerUse) {
            scoreA++;
          } else if (b.costPerUse < a.costPerUse) {
            scoreB++;
          }

        }


        const priority =
          document.getElementById("priority").value;


        let winner = null;
        let reason = "";


        if (priority === "price") {

          if (a.price < b.price) {

            winner = a;
            reason = "Tem o menor preço inicial.";

          } else if (b.price < a.price) {

            winner = b;
            reason = "Tem o menor preço inicial.";

          } else {

            reason =
              "Os dois produtos têm o mesmo preço.";

          }

        }


        else if (priority === "durability") {

          if (a.years > b.years) {

            winner = a;
            reason =
              "Tem a maior duração estimada.";

          } else if (b.years > a.years) {

            winner = b;
            reason =
              "Tem a maior duração estimada.";

          } else {

            reason =
              "Os dois produtos têm a mesma duração estimada.";

          }

        }


        else if (priority === "use") {

          if (
            a.costPerUse !== null &&
            b.costPerUse !== null
          ) {

            if (a.costPerUse < b.costPerUse) {

              winner = a;
              reason =
                "Tem o menor custo estimado por utilização.";

            } else if (b.costPerUse < a.costPerUse) {

              winner = b;
              reason =
                "Tem o menor custo estimado por utilização.";

            } else {

              reason =
                "O custo por utilização é igual.";

            }

          } else {

            reason =
              "Informe usos maiores que zero para comparar.";

          }

        }


        else {

          if (scoreA > scoreB) {

            winner = a;
            reason =
              "Venceu em mais critérios calculados.";

          } else if (scoreB > scoreA) {

            winner = b;
            reason =
              "Venceu em mais critérios calculados.";

          } else {

            reason =
              "Os critérios ficaram empatados.";

          }

        }


        document.getElementById("winnerName").textContent =
          winner ? winner.name : "Empate";


        document.getElementById("winnerReason").textContent =
          reason;


        document.getElementById("scoreLabelA").textContent =
          a.name;


        document.getElementById("scoreLabelB").textContent =
          b.name;


        document.getElementById("scoreA").textContent =
          scoreA + "/3";


        document.getElementById("scoreB").textContent =
          scoreB + "/3";


        document.getElementById("lowestPrice").textContent =
          money(Math.min(a.price, b.price));


        document.getElementById("lowestAnnual").textContent =
          money(Math.min(a.annualCost, b.annualCost));


        document.getElementById("details").innerHTML = `

          <div class="comparison-row">

            <div class="values">

              <div class="value">
                <strong>${escapeHTML(a.name)}</strong>
              </div>

              <div class="value">
                <strong>${escapeHTML(b.name)}</strong>
              </div>

            </div>

          </div>


          ${createRow(
            "Preço inicial",
            a.price,
            b.price,
            money,
            "lower"
          )}


          ${createRow(
            "Duração estimada",
            a.years,
            b.years,
            function (value) {
              return number(value) + " anos";
            },
            "higher"
          )}


          ${createRow(
            "Custo por ano",
            a.annualCost,
            b.annualCost,
            money,
            "lower"
          )}


          ${createRow(
            "Usos estimados durante a vida útil",
            a.totalUses,
            b.totalUses,
            function (value) {
              return Math.round(value).toLocaleString("pt-BR");
            },
            "higher"
          )}


          ${createRow(
            "Custo estimado por utilização",
            a.costPerUse === null
              ? Infinity
              : a.costPerUse,
            b.costPerUse === null
              ? Infinity
              : b.costPerUse,
            function (value) {

              if (!Number.isFinite(value)) {
                return "Sem uso";
              }

              return money(value);

            },
            "lower"
          )}

        `;


        let finalText = "";


        if (priority === "price") {

          if (winner) {

            finalText =
              winner.name +
              " custa menos inicialmente. " +
              "Antes de decidir, considere também a durabilidade " +
              "e a qualidade do produto.";

          } else {

            finalText =
              "Os dois produtos possuem o mesmo preço inicial.";

          }

        }


        else if (priority === "durability") {

          if (winner) {

            finalText =
              winner.name +
              " possui a maior duração estimada. " +
              "Isso não garante que o produto realmente terá essa vida útil.";

          } else {

            finalText =
              "Os dois produtos possuem a mesma duração estimada.";

          }

        }


        else if (priority === "use") {

          if (winner) {

            finalText =
              winner.name +
              " apresenta o menor custo estimado por utilização.";

          } else {

            finalText =
              "Não foi possível encontrar uma vantagem clara pelo custo por utilização.";

          }

        }


        else {

          if (winner) {

            finalText =
              winner.name +
              " apresentou vantagem em mais critérios numéricos nesta comparação.";

          } else {

            finalText =
              "Os critérios numéricos ficaram empatados. Nesse caso, qualidade, garantia e suas preferências devem pesar na decisão.";

          }

        }


        document.getElementById("verdict").textContent =
          finalText;


        result.classList.remove("hidden");


        result.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });

      });


      document
        .getElementById("newComparison")
        .addEventListener("click", function () {

          form.reset();

          error.textContent = "";

          result.classList.add("hidden");

          window.scrollTo({
            top: 0,
            behavior: "smooth"
          });

        });


    })();

  </script>

</body>
</html>
