<!DOCTYPE html>

<html lang="pt-BR">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="theme-color" content="#101827">

<meta name="description" content="Compare produtos, calcule custos e descubra o que vale mais a pena antes de comprar.">

<title>Vale a Pena? — Compre melhor</title>

<style>

:root {

  --bg:#0b1120;

  --card:#141e30;

  --card2:#1a2740;

  --text:#f4f7ff;

  --muted:#a4b1c8;

  --green:#52e0a0;

  --blue:#7ba7ff;

  --border:#2b3a52;

}

*{box-sizing:border-box}

body{

  margin:0;

  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;

  background:var(--bg);

  color:var(--text);

  line-height:1.5;

}

button,input,select{font:inherit}

button{cursor:pointer}

.container{width:min(100% - 32px,760px);margin:auto}

header{padding:25px 0 15px;border-bottom:1px solid var(--border)}

.brand{font-size:23px;font-weight:850;letter-spacing:-.8px}

.brand span{color:var(--green)}

.tagline{font-size:13px;color:var(--muted);margin-top:3px}

.hero{padding:35px 0 22px}

.eyebrow{color:var(--green);font-size:12px;font-weight:800;letter-spacing:1.5px}

h1{font-size:clamp(30px,7vw,44px);line-height:1.1;letter-spacing:-1.5px;margin:10px 0}

.hero p{color:var(--muted);max-width:520px;margin:12px 0}

.panel{

  background:var(--card);

  border:1px solid var(--border);

  border-radius:18px;

  padding:20px;

  margin:18px 0;

}

h2{font-size:20px;margin:0 0 5px}

.subtitle{font-size:13px;color:var(--muted);margin:0 0 20px}

.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}

.field{margin-bottom:15px;min-width:0}

label{display:block;font-size:13px;color:#d9e2f3;margin-bottom:7px;font-weight:600}

input,select{

  width:100%;min-width:0;

  background:#0d1626;color:var(--text);

  border:1px solid var(--border);

  border-radius:10px;padding:12px;

  outline:none;

}

input:focus,select:focus{border-color:var(--green)}

.product-title{

  display:flex;align-items:center;gap:8px;

  font-weight:800;font-size:15px;margin-bottom:15px;

}

.dot{width:10px;height:10px;border-radius:50%;background:var(--blue)}

.dot.b{background:var(--green)}

.section-title{font-size:16px;font-weight:800;margin:24px 0 12px}

.hint{font-size:12px;color:var(--muted);margin-top:5px}

.primary{

  display:block;width:100%;border:0;border-radius:12px;

  background:var(--green);color:#071a13;font-weight:850;

  padding:15px;margin-top:10px;

}

.primary:active{transform:scale(.99)}

.secondary{

  border:1px solid var(--border);background:var(--card2);

  color:var(--text);border-radius:10px;padding:11px 15px;

}

.error{color:#ff9999;font-size:13px;margin-top:10px}

.hidden{display:none!important}

.winner{

  text-align:center;padding:25px 15px;

  border:1px solid #337d60;background:#112b27;

  border-radius:15px;margin:16px 0;

}

.trophy{font-size:34px}

.winner h2{font-size:26px;color:var(--green);margin:8px 0}

.winner p{color:#c8e8dc;margin:0;font-size:14px}

.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}

.stat{background:#0d1626;padding:14px;border-radius:12px;border:1px solid var(--border)}

.stat small{display:block;color:var(--muted);font-size:12px}

.stat strong{font-size:21px;display:block;margin-top:4px;overflow-wrap:anywhere}

.comparison-row{

  padding:15px 0;border-bottom:1px solid var(--border)

}

.comparison-row:last-child{border-bottom:0}

.metric{font-weight:750;margin-bottom:9px}

.values{display:grid;grid-template-columns:1fr 1fr;gap:10px}

.value{font-size:14px;color:var(--muted)}

.value strong{display:block;font-size:17px;color:var(--text)}

.value.best strong{color:var(--green)}

.badge{

  display:inline-block;font-size:10px;font-weight:800;

  color:var(--green);background:#173b30;padding:3px 7px;

  border-radius:20px;margin-top:5px

}

.verdict{font-size:14px;color:#d2dced}

.disclaimer{font-size:12px;color:var(--muted);margin-top:15px}

footer{text-align:center;padding:28px 0 40px;color:var(--muted);font-size:12px}

@media(max-width:480px){

  .panel{padding:16px}

  .grid{gap:10px}

  input,select{padding:11px 9px;font-size:14px}

  .stats{gap:8px}

  .stat strong{font-size:18px}

}

</style>

</head>

<body>

<header>

  <div class="container">

    <div class="brand">VALE <span>A PENA?</span></div>

    <div class="tagline">Decisões melhores. Dinheiro mais bem gasto.</div>

  </div>

</header>

<main class="container">

  <section class="hero">

    <div class="eyebrow">COMPRE COM INTELIGÊNCIA</div>

    <h1>Antes de comprar,<br>compare.</h1>

    <p>Dois produtos, uma decisão. Descubra os custos, compare a durabilidade e avalie qual opção faz mais sentido para você.</p>

  </section>

  <form id="formulario">

    <section class="panel">

      <h2>01. Suas opções</h2>

      <p class="subtitle">Informe os produtos que está considerando comprar.</p>

      <div class="grid">

        <div class="field">

          <label for="nomeA">Produto A</label>

          <input id="nomeA" placeholder="Ex.: iPhone 15" maxlength="70" required>

        </div>

        <div class="field">

          <label for="nomeB">Produto B</label>

          <input id="nomeB" placeholder="Ex.: Galaxy S24" maxlength="70" required>

        </div>

        <div class="field">

          <label for="precoA">Preço (R$)</label>

          <input id="precoA" type="number" min="0.01" step="0.01" placeholder="3500" required>

        </div>

        <div class="field">

          <label for="precoB">Preço (R$)</label>

          <input id="precoB" type="number" min="0.01" step="0.01" placeholder="3000" required>

        </div>

      </div>

      <div class="section-title">02. Quanto tempo devem durar?</div>

      <div class="grid">

        <div class="field">

          <label for="durA">Produto A (anos)</label>

          <input id="durA" type="number" min="0.1" max="100" step="0.1" placeholder="5" required>

        </div>

        <div class="field">

          <label for="durB">Produto B (anos)</label>

          <input id="durB" type="number" min="0.1" max="100" step="0.1" placeholder="4" required>

        </div>

      </div>

      <p class="hint">Use uma estimativa realista de vida útil. Não é uma garantia de durabilidade.</p>

      <div class="section-title">03. Frequência de uso</div>

      <div class="grid">

        <div class="field">

          <label for="usoA">Usos por semana — A</label>

          <input id="usoA" type="number" min="0" step="1" placeholder="35" required>

        </div>

        <div class="field">

          <label for="usoB">Usos por semana — B</label>

          <input id="usoB" type="number" min="0" step="1" placeholder="35" required>

        </div>

      </div>

      <p class="hint">Considere uma utilização como uma sessão ou ocasião de uso. Use a mesma definição nos dois produtos.</p>

      <div class="field" style="margin-top:22px">

        <label for="prioridade">O que mais importa para você?</label>

        <select id="prioridade">

          <option value="equilibrado">Equilíbrio entre preço e durabilidade</option>

          <option value="preco">Gastar menos agora</option>

          <option value="durabilidade">Durar mais tempo</option>

          <option value="uso">Menor custo por utilização</option>

        </select>

      </div>

      <button type="submit" class="primary">Comparar produtos →</button>

      <div id="erro" class="error" role="alert"></div>

    </section>

  </form>

  <section id="resultado" class="panel hidden" aria-live="polite">

    <div class="eyebrow">SUA ANÁLISE</div>

    <h2>Resultado da comparação</h2>

    <p class="subtitle">Veja os números antes de decidir.</p>

    <div class="winner">

      <div class="trophy">🏆</div>

      <h2 id="vencedor"></h2>

      <p id="motivo"></p>

    </div>

    <div class="stats">

      <div class="stat">

        <small>Menor preço inicial</small>

        <strong id="menorPreco"></strong>

        <small id="economiaInicial"></small>

      </div>

      <div class="stat">

        <small>Menor custo por ano</small>

        <strong id="menorAno"></strong>

        <small id="economiaAno"></small>

      </div>

    </div>

    <div class="section-title">Comparação detalhada</div>

    <div id="detalhes"></div>

    <div class="section-title">Veredito</div>

    <p class="verdict" id="veredito"></p>

    <p class="disclaimer">Esta análise utiliza as informações fornecidas por você. Custos de manutenção, energia, reparos, revenda, inflação e diferenças de qualidade não estão incluídos. A estimativa não garante qual produto terá melhor desempenho.</p>

    <button id="nova" class="primary" type="button">Fazer nova comparação</button>

  </section>

  <section class="panel">

    <h2>Como funciona?</h2>

    <p class="subtitle" style="margin-bottom:0">Comparamos preço inicial, custo anual estimado e custo por utilização. A recomendação leva em conta sua prioridade, mas não substitui a avaliação da qualidade e das características de cada produto.</p>

  </section>

</main>

<footer>VALE A PENA? · Pense antes de gastar.</footer>

<script>

(function(){

  "use strict";

  const $ = id => document.getElementById(id);

  function numero(id){

    return Number($(id).value);

  }

  function moeda(valor){

    return valor.toLocaleString("pt-BR",{

      style:"currency",currency:"BRL"

    });

  }

  function decimal(valor){

    return valor.toLocaleString("pt-BR",{

      minimumFractionDigits:2,maximumFractionDigits:2

    });

  }

  function escapar(texto){

    return String(texto).replace(/[&<>"']/g,function(c){

      return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];

    });

  }

  function linha(titulo,a,b,formatar,melhor){

    let vencedorA = melhor === "menor" ? a < b : a > b;

    let vencedorB = melhor === "menor" ? b < a : b > a;

    return `

      <div class="comparison-row">

        <div class="metric">${titulo}</div>

        <div class="values">

          <div class="value ${vencedorA ? "best" : ""}">

            <strong>${formatar(a)}</strong>

            ${vencedorA ? '<span class="badge">MELHOR</span>' : ""}

          </div>

          <div class="value ${vencedorB ? "best" : ""}">

            <strong>${formatar(b)}</strong>

            ${vencedorB ? '<span class="badge">MELHOR</span>' : ""}

          </div>

        </div>

      </div>`;

  }

  $("formulario").addEventListener("submit",function(event){

    event.preventDefault();

    $("erro").textContent = "";

    const a = {

      nome:$("nomeA").value.trim(),

      preco:numero("precoA"),

      dur:numero("durA"),

      uso:numero("usoA")

    };

    const b = {

      nome:$("nomeB").value.trim(),

      preco:numero("precoB"),

      dur:numero("durB"),

      uso:numero("usoB")

    };

    if(!a.nome || !b.nome){

      $("erro").textContent = "Informe os nomes dos dois produtos.";

      return;

    }

    if(a.preco<=0 || b.preco<=0 || a.dur<=0 || b.dur<=0 ||

       a.uso<0 || b.uso<0 ||

       ![a.preco,b.preco,a.dur,b.dur,a.uso,b.uso].every(Number.isFinite)){

      $("erro").textContent = "Confira os valores: preços e duração devem ser maiores que zero; usos não podem ser negativos.";

      return;

    }

    a.ano=a.preco/a.dur;

    b.ano=b.preco/b.dur;

    a.totalUsos=a.uso*52*a.dur;

    b.totalUsos=b.uso*52*b.dur;

    a.porUso=a.totalUsos>0?a.preco/a.totalUsos:null;

    b.porUso=b.totalUsos>0?b.preco/b.totalUsos:null;

    const prioridade=$("prioridade").value;

    let pontosA=0,pontosB=0;

    if(a.preco<b.preco)pontosA++;

    else if(b.preco<a.preco)pontosB++;

    if(a.ano<b.ano)pontosA++;

    else if(b.ano<a.ano)pontosB++;

    if(a.porUso!==null && b.porUso!==null){

      if(a.porUso<b.porUso)pontosA++;

      else if(b.porUso<a.porUso)pontosB++;

    }

    let recomendacao;

    if(prioridade==="preco"){

      recomendacao=a.preco<b.preco?a:b;

    }else if(prioridade==="durabilidade"){

      recomendacao=a.dur>b.dur?a:b;

    }else if(prioridade==="uso" && a.porUso!==null && b.porUso!==null){

      recomendacao=a.porUso<b.porUso?a:b;

    }else{

      recomendacao=pontosA>pontosB?a:pontosB>pontosA?b:null;

    }

    if(!recomendacao){

      $("vencedor").textContent="Empate nos critérios";

      $("motivo").textContent="Os dados não indicam um vencedor claro.";

    }else{

      $("vencedor").textContent=recomendacao.nome;

      const razoes={

        preco:"É a opção com menor preço inicial.",

        durabilidade:"É a opção com maior duração estimada.",

        uso:"Apresenta o menor custo estimado por utilização.",

        equilibrado:"Apresenta o melhor resultado geral nos critérios calculados."

      };

      $("motivo").textContent=razoes[prioridade];

    }

    $("menorPreco").textContent=moeda(Math.min(a.preco,b.preco));

    $("economiaInicial").textContent=

      "Diferença: "+moeda(Math.abs(a.preco-b.preco));

    $("menorAno").textContent=moeda(Math.min(a.ano,b.ano));

    $("economiaAno").textContent=

      "Diferença: "+moeda(Math.abs(a.ano-b.ano))+" por ano";

    $("detalhes").innerHTML=

      `<div class="comparison-row"><div class="values">

        <div class="value"><strong>${escapar(a.nome)}</strong></div>

        <div class="value"><strong>${escapar(b.nome)}</strong></div>

      </div></div>`+

      linha("Preço inicial",a.preco,b.preco,moeda,"menor")+

      linha("Duração estimada",a.dur,b.dur,v=>decimal(v)+" anos","maior")+

      linha("Custo por ano",a.ano,b.ano,moeda,"menor")+

      linha("Usos estimados durante a vida útil",a.totalUsos,b.totalUsos,v=>Math.round(v).toLocaleString("pt-BR"),"maior")+

      linha("Custo estimado por uso",a.porUso===null?Infinity:a.porUso,b.porUso===null?Infinity:b.porUso,v=>Number.isFinite(v)?moeda(v):"Sem uso informado","menor");

    let texto;

    if(prioridade==="preco"){

      texto=`${a.preco===b.preco?"Os dois produtos têm o mesmo preço.":recomendacao.nome+" custa menos inicialmente."} Considere se a economia inicial compensa possíveis diferenças de duração, qualidade e manutenção.`;

    }else if(prioridade==="durabilidade"){

      texto=`${recomendacao.nome} tem a maior duração estimada informada. Essa estimativa é fornecida por você, não uma previsão garantida. Compare também o custo anual e a qualidade.`;

    }else if(prioridade==="uso"){

      texto=(a.porUso===null || b.porUso===null)

        ?"Informe uma frequência de uso maior que zero para ambos os produtos para comparar o custo por utilização."

        :`${recomendacao.nome} tem o menor custo estimado por utilização, com base na frequência de uso e duração informadas.`;

    }else{

      texto=recomendacao

        ?`${recomendacao.nome} vence em mais critérios calculáveis nesta comparação. Avalie também qualidade, recursos, garantia e custos extras antes de comprar.`

        :"Os critérios calculados ficaram empatados. Considere qualidade, garantia, recursos e suas preferências pessoais.";

    }

    $("veredito").textContent=texto;

    $("resultado").classList.remove("hidden");

    $("resultado").scrollIntoView({behavior:"smooth",block:"start"});

  });

  $("nova").addEventListener("click",function(){

    $("formulario").reset();

    $("resultado").classList.add("hidden");

    $("erro").textContent="";

window.scrollTo({top:0,behavior:"smooth"});

  });

})();

</script>

</body>

</html>
